{
  "name": "cira-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "CIRA — a user-owned, model-independent AI context layer.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:extension": "pnpm --filter @cira/browser-extension dev",
    "build:extension": "pnpm --filter @cira/browser-extension build",
    "cira": "node cli/dist/cira.js",
    "mcp": "node packages/mcp/dist/server.js",
    "generate:schema": "pnpm --filter @cira/pco generate",
    "smoke": "node scripts/smoke-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "5.0.2"
  }
}
